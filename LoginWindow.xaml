<Window x:Class="ShipnetOnline.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shipnet Online — Sign In"
        Height="440" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrandBackgroundBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Shipnet Online"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource BrandDarkBrush}" />
            <TextBlock Text="Secure remote access" FontSize="13" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Cached user banner -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="12" CornerRadius="4"
                Background="#E9F1FA"
                Visibility="{Binding HasCachedUser, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding CachedUsername, StringFormat='Welcome back, {0}'}" FontSize="13" />
        </Border>

        <!-- Main content -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <TextBlock Text="Sign in with your Microsoft work account to continue."
                       TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#444" />

            <Button Content="Sign in with Microsoft"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding CanLogin}"
                    HorizontalAlignment="Stretch"
                    Height="42" />

            <CheckBox Content="Remember me on this device"
                      IsChecked="{Binding RememberMe}"
                      Margin="0,16,0,0" />

            <Button Content="Sign out / clear saved session"
                    Command="{Binding SignOutCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#888"
                    Cursor="Hand"
                    Visibility="{Binding HasCachedUser, Converter={StaticResource BoolToVis}}" />

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   FontSize="12" Foreground="{StaticResource BrandDarkBrush}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />

        <!-- Network status -->
        <TextBlock Grid.Row="4" Text="{Binding NetworkStatus}"
                   FontSize="11" Foreground="Gray"
                   Margin="0,6,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
